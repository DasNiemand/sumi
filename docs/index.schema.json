{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sumi/index.schema.json",
  "title": "SUMI registry index.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "apps"],
  "properties": {
    "version": { "const": 1 },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repo", "ref", "sha"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
          "repo": { "type": "string", "pattern": "^github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
          "ref": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
