#!/usr/bin/env bash
# sumi <app> [function]   chạy app (oneshot: chạy thẳng; daemon: khởi động nếu cần rồi gọi IPC)
# sumi hub                mở hub (launcher) trên màn hình đang focus
# sumi list [--json]      liệt kê app đã cài (JSON dùng cho hub)
# sumi reset [--force]    sao lưu rồi xoá config.json (về mặc định)
# sumi config apply <json|->   kiểm tra, sao lưu, ghi config.json nguyên tử (hub dùng)
# sumi config backups          liệt kê bản sao lưu
# sumi config restore [stamp]  khôi phục bản sao lưu (mặc định: mới nhất), có sao lưu bản hiện tại trước
# sumi store <lệnh>       cửa hàng app: registry|inspect|install|update|remove|removed|restore (xem `sumi store help`)
# sumi version            version lõi đã cài
# sumi update [--check|--yes]   cập nhật lõi (tag vX.Y.Z mới nhất của repo sumi)
# sumi uninstall [--yes|--purge] gỡ lõi (không --yes: chỉ in kế hoạch)
# sumi doctor             kiểm tra môi trường
#
# Không phụ thuộc hub: app oneshot (kakunin) được gọi từ script nên phải chạy nhanh, không đụng mạng.
set -u

SUMI_HOME="${SUMI_HOME:-$HOME/.local/share/sumi}"
CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sumi"

die() { echo "sumi: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "thiếu lệnh '$1'"; }

manifest_field() { jq -r "$2 // empty" "$1/manifest.json" 2>/dev/null; }

run_argv() {  # $1 = app dir ; in argv (mỗi phần tử một dòng) với {dir} đã thay
    local dir="$1" run
    run="$(manifest_field "$dir" '.run')"
    [ -n "$run" ] || return 1
    local -a argv
    read -ra argv <<<"$run"
    local i
    for i in "${!argv[@]}"; do argv[$i]="${argv[$i]//\{dir\}/$dir}"; done
    printf '%s\n' "${argv[@]}"
}

cmd_list() {
    need jq
    local json='[]' d running obj inst='{}'
    if [ -f "$CFG_DIR/installed.json" ]; then
        inst="$(jq -c '.apps // {}' "$CFG_DIR/installed.json" 2>/dev/null)" || inst='{}'
        [ -n "$inst" ] || inst='{}'
    fi
    for d in "$SUMI_HOME"/apps/*/; do
        d="${d%/}"
        [ -f "$d/manifest.json" ] || continue
        running=false
        pgrep -f -- "-p $d/shell.qml" >/dev/null 2>&1 && running=true
        # manifest hỏng thì bỏ qua app đó, không làm hỏng cả danh sách
        obj="$(jq -c --argjson r "$running" --arg dir "$d" --argjson inst "$inst" '{
            id, name, kanji: (.kanji // ""), description: (.description // ""), version, kind,
            running: $r, dir: $dir,
            source: ($inst[.id].source // "dev"), ref: ($inst[.id].ref // ""), sha: ($inst[.id].sha // ""),
            functions: [.functions[] | {id, label, ipc_name: (.ipc_name // .id), objects: (.objects // []), defaultObject: (.defaultObject // "")}],
            keybinds: [(.keybinds // [])[] | {action, default: (.default // ""), label: (.label // .action), locked: (.locked // false)}],
            fonts: (.fonts // []),
            options: [(.options // [])[] | {key, type, default, label: (.label // .key), locked: (.locked // false)} + (if has("min") then {min} else {} end) + (if has("max") then {max} else {} end) + (if has("values") then {values} else {} end)]
        }' "$d/manifest.json" 2>/dev/null)" || continue
        [ -n "$obj" ] || continue
        json="$(jq -c --argjson o "$obj" '. + [$o]' <<<"$json")"
    done
    if [ "${1:-}" = "--json" ]; then
        printf '%s\n' "$json"
    else
        jq -r '.[] | "\(.id)\t\(.version)\t\(.kind)\t\(if .running then "running" else "-" end)"' <<<"$json"
    fi
}

cmd_hub() {
    local dir="$SUMI_HOME/hub"
    [ -f "$dir/shell.qml" ] || die "hub chưa cài ($dir/shell.qml không tồn tại)"
    # Đã mở rồi thì không mở thêm
    pgrep -f -- "-p $dir/shell.qml" >/dev/null 2>&1 && exit 0
    local mon=""
    if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        mon="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null | head -n1)"
    fi
    SUMI_MONITOR="$mon" exec qs -p "$dir/shell.qml"
}

cmd_reset() {
    local force=0
    [ "${1:-}" = "--force" ] && force=1
    local f="$CFG_DIR/config.json"
    [ -f "$f" ] || { echo "sumi: không có config.json, đã ở mặc định."; return 0; }
    if [ "$force" -eq 0 ] && pgrep -f "$SUMI_HOME/apps/[a-z0-9-]*/shell.qml" >/dev/null 2>&1; then
        die "có app SUMI đang chạy. Tắt app trước, hoặc dùng: sumi reset --force"
    fi
    local ts dst
    ts="$(date +%Y%m%d-%H%M%S)"; dst="$CFG_DIR/backups/$ts"
    mkdir -p "$dst" && cp -a "$f" "$dst/config.json" && rm -f "$f" || die "reset thất bại, config giữ nguyên"
    echo "sumi: đã sao lưu vào $dst và xoá config.json (về mặc định)."
}

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>/tmp/sumi.log 2>/dev/null || true; }

# Sao lưu config.json hiện tại vào backups/<stamp>/ ; in stamp ra stdout (rỗng nếu chưa có config).
config_backup() {
    local f="$CFG_DIR/config.json" ts dst n=0
    [ -f "$f" ] || return 0
    ts="$(date +%Y%m%d-%H%M%S)"; dst="$CFG_DIR/backups/$ts"
    while [ -e "$dst" ]; do n=$((n + 1)); dst="$CFG_DIR/backups/$ts-$n"; done
    mkdir -p "$dst" && cp -a "$f" "$dst/config.json" || die "không sao lưu được, config giữ nguyên"
    basename "$dst"
}

# Giữ tối đa N bản (theo hub.maxBackups, mặc định 20, kẹp 5..100). Chỉ đụng thư mục dạng YYYYMMDD-HHMMSS[-n].
config_prune() {
    local max=20 v
    v="$(jq -r '.hub.maxBackups // empty' "$CFG_DIR/config.json" 2>/dev/null)"
    [[ "$v" =~ ^[0-9]+$ ]] && max="$v"
    [ "$max" -lt 5 ] && max=5
    [ "$max" -gt 100 ] && max=100
    local -a all
    mapfile -t all < <(ls -1 "$CFG_DIR/backups" 2>/dev/null | grep -E '^[0-9]{8}-[0-9]{6}(-[0-9]+)?$' | sort -r)
    local i
    for ((i = max; i < ${#all[@]}; i++)); do rm -rf -- "$CFG_DIR/backups/${all[$i]}"; done
}

config_lock() {
    mkdir -p "$CFG_DIR"
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$CFG_DIR/sumi.lock"
        flock -w 5 9 || die "đang có thao tác khác giữ sumi.lock"
    fi
}

cmd_config() {
    need jq
    local sub="${1:-}"; shift || true
    case "$sub" in
        apply)
            local in="${1:-}" tmp
            [ -n "$in" ] || die "dùng: sumi config apply <json|->"
            [ "$in" = "-" ] && in="$(cat)"
            printf '%s' "$in" | jq -e '
                type == "object" and .version == 1 and (.global | type == "object")
                and ((keys - ["version","global","hub","apps"]) | length == 0)
                and ((.apps // {}) | type == "object")' >/dev/null 2>&1 \
                || { log "config apply: bị từ chối (JSON hoặc cấu trúc không hợp lệ)"; die "config không hợp lệ (cần object có version=1 và global)"; }
            config_lock
            mkdir -p "$CFG_DIR/backups"
            local stamp; stamp="$(config_backup)"
            tmp="$(mktemp "$CFG_DIR/config.json.XXXXXX")" || die "không tạo được file tạm"
            if ! printf '%s' "$in" | jq '.' >"$tmp" 2>/dev/null; then rm -f "$tmp"; die "ghi file tạm thất bại, config giữ nguyên"; fi
            mv -f "$tmp" "$CFG_DIR/config.json" || { rm -f "$tmp"; die "đổi tên thất bại, config giữ nguyên"; }
            config_prune
            log "config apply: ok (backup ${stamp:-none})"
            echo "${stamp:-none}"
            ;;
        backups)
            ls -1 "$CFG_DIR/backups" 2>/dev/null | grep -E '^[0-9]{8}-[0-9]{6}(-[0-9]+)?$' | sort -r
            ;;
        restore)
            local want="${1:-}" src
            if [ -z "$want" ]; then want="$(ls -1 "$CFG_DIR/backups" 2>/dev/null | grep -E '^[0-9]{8}-[0-9]{6}(-[0-9]+)?$' | sort -r | head -n1)"; fi
            [ -n "$want" ] || die "không có bản sao lưu nào"
            [[ "$want" =~ ^[0-9]{8}-[0-9]{6}(-[0-9]+)?$ ]] || die "stamp không hợp lệ: $want"
            src="$CFG_DIR/backups/$want/config.json"
            [ -f "$src" ] || die "không thấy $src"
            jq -e 'type == "object"' "$src" >/dev/null 2>&1 || die "bản sao lưu hỏng: $src"
            config_lock
            local stamp tmp
            stamp="$(config_backup)"
            tmp="$(mktemp "$CFG_DIR/config.json.XXXXXX")" || die "không tạo được file tạm"
            cp "$src" "$tmp" && mv -f "$tmp" "$CFG_DIR/config.json" || { rm -f "$tmp"; die "khôi phục thất bại"; }
            log "config restore: $want (bản trước đó lưu ở ${stamp:-none})"
            echo "đã khôi phục $want (bản trước đó: ${stamp:-không có})"
            ;;
        *) die "dùng: sumi config apply <json|-> | backups | restore [stamp]" ;;
    esac
}

cmd_store() {
    local self; self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    local bin; bin="$(dirname "$self")/sumi-store"
    [ -x "$bin" ] || die "thiếu $bin (chạy lại install-dev.sh)"
    exec "$bin" "$@"
}

cmd_self() {
    local self bin; self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    bin="$(dirname "$self")/sumi-self"
    [ -x "$bin" ] || die "thiếu $bin (chạy lại install.sh)"
    exec "$bin" "$@"
}

cmd_doctor() {
    local fails=0 warns=0
    ok_()   { echo "ok    $*"; }
    warn_() { echo "warn  $*"; warns=$((warns + 1)); }
    fail_() { echo "FAIL  $*"; fails=$((fails + 1)); }
    local c v
    # --- lõi ---
    if [ -f "$SUMI_HOME/install.json" ] && jq -e . "$SUMI_HOME/install.json" >/dev/null 2>&1; then
        ok_ "SUMI $(jq -r '.version // "?"' "$SUMI_HOME/install.json") (lib $(cat "$SUMI_HOME/lib/VERSION" 2>/dev/null || echo '?'))"
    else
        warn_ "chưa có install.json hợp lệ (chưa cài bằng install.sh hoặc install-dev.sh)"
    fi
    for c in jq git curl; do command -v "$c" >/dev/null 2>&1 && ok_ "$c" || fail_ "thiếu $c"; done
    if command -v quickshell >/dev/null 2>&1 || command -v qs >/dev/null 2>&1; then ok_ "quickshell ($(command -v quickshell >/dev/null 2>&1 && echo quickshell || echo qs))"; else fail_ "thiếu quickshell (quickshell hoặc qs)"; fi
    command -v hyprctl >/dev/null 2>&1 && ok_ "hyprctl" || warn_ "thiếu hyprctl (hub không chọn được màn hình theo focus)"
    command -v flock >/dev/null 2>&1 && ok_ "flock" || warn_ "thiếu flock (ghi config không có khoá)"
    local self_dir; self_dir="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
    case ":$PATH:" in *":$self_dir:"*) ok_ "PATH có $self_dir" ;; *) warn_ "$self_dir chưa nằm trong PATH" ;; esac
    for c in sumi-store sumi-self; do [ -x "$self_dir/$c" ] && ok_ "$c" || fail_ "thiếu $self_dir/$c (chạy lại install.sh)"; done
    # --- lib và hub ---
    local libv hubv
    libv="$(tr -d '[:space:]' <"$SUMI_HOME/lib/VERSION" 2>/dev/null || true)"
    if [ -n "$libv" ]; then ok_ "lib $libv ($SUMI_HOME/lib)"; else fail_ "thiếu lib ($SUMI_HOME/lib/VERSION)"; fi
    if [ -f "$SUMI_HOME/hub/shell.qml" ]; then
        hubv="$(tr -d '[:space:]' <"$SUMI_HOME/hub/lib/VERSION" 2>/dev/null || true)"
        if [ -z "$hubv" ]; then fail_ "hub thiếu lib vendored ($SUMI_HOME/hub/lib)"
        elif [ -n "$libv" ] && [ "$hubv" != "$libv" ]; then warn_ "lib trong hub ($hubv) khác lib chung ($libv): chạy lại install.sh / install-dev.sh"
        else ok_ "hub (lib $hubv)"; fi
    else
        warn_ "chưa có hub ($SUMI_HOME/hub)"
    fi
    # --- cấu hình ---
    if [ -f "$CFG_DIR/colors.json" ]; then
        if jq -e 'type == "object"' "$CFG_DIR/colors.json" >/dev/null 2>&1; then
            local missing
            missing="$(jq -r '[ "primary","on_primary","surface","on_surface","surface_variant","on_surface_variant","outline" ] - keys | join(", ")' "$CFG_DIR/colors.json" 2>/dev/null)"
            if [ -z "$missing" ]; then ok_ "colors.json (đủ 7 màu)"; else warn_ "colors.json thiếu màu: $missing (màu thiếu dùng mặc định)"; fi
        else fail_ "colors.json không phải JSON object hợp lệ"; fi
    else
        warn_ "chưa có colors.json (app dùng màu mặc định; muốn lấy màu từ Noctalia xem docs/CONVENTIONS.md)"
    fi
    if [ -f "$CFG_DIR/config.json" ]; then
        if ! jq -e 'type == "object"' "$CFG_DIR/config.json" >/dev/null 2>&1; then fail_ "config.json hỏng (không phải JSON object): app sẽ dùng mặc định; khôi phục: sumi config backups"
        elif [ "$(jq -r '.version // empty' "$CFG_DIR/config.json")" != 1 ]; then warn_ "config.json có version khác 1: app có thể bỏ qua"
        else ok_ "config.json ($(jq -r '[.apps // {} | keys[]] | length' "$CFG_DIR/config.json") app có cấu hình riêng)"; fi
    else
        ok_ "chưa có config.json (app dùng mặc định)"
    fi
    if [ -f "$CFG_DIR/installed.json" ]; then
        jq -e 'type == "object" and .version == 1 and (.apps | type == "object")' "$CFG_DIR/installed.json" >/dev/null 2>&1 && ok_ "installed.json" || fail_ "installed.json hỏng (sumi store sẽ từ chối): sửa hoặc xoá $CFG_DIR/installed.json"
    fi
    # --- app ---
    local d id req av n=0
    for d in "$SUMI_HOME"/apps/*/; do
        [ -d "$d" ] || continue
        d="${d%/}"; id="$(basename "$d")"; n=$((n + 1))
        if [ ! -f "$d/manifest.json" ] || ! jq -e 'type == "object" and .id and .version and .kind and .run' "$d/manifest.json" >/dev/null 2>&1; then fail_ "app $id: manifest.json thiếu hoặc không hợp lệ"; continue; fi
        if [ "$(jq -r .id "$d/manifest.json")" != "$id" ]; then fail_ "app $id: manifest ghi id '$(jq -r .id "$d/manifest.json")' khác tên thư mục"; continue; fi
        for v in View.qml shell.qml; do [ -f "$d/$v" ] || fail_ "app $id: thiếu $v"; done
        av="$(tr -d '[:space:]' <"$d/lib/VERSION" 2>/dev/null || true)"
        req="$(jq -r '.requires_lib // ""' "$d/manifest.json")"
        if [ -z "$av" ]; then fail_ "app $id: thiếu lib vendored ($d/lib): chạy lại install.sh / install-dev.sh"
        elif [ -n "$req" ] && ! lib_ok "$av" "$req"; then fail_ "app $id: cần lib '$req' nhưng lib trong app là $av: cập nhật app (sumi store) hoặc lõi"
        else ok_ "app $id $(jq -r .version "$d/manifest.json") ($(jq -r .kind "$d/manifest.json")) lib $av"; fi
    done
    [ "$n" -gt 0 ] || ok_ "chưa cài app nào (G trong hub để mở cửa hàng)"
    # --- rác và sao lưu ---
    local stale
    stale="$(find "$SUMI_HOME/.staging" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)"
    [ "$stale" -eq 0 ] && ok_ "không có thư mục tạm cũ" || warn_ "$stale thư mục tạm trong $SUMI_HOME/.staging (thao tác bị ngắt?); xoá được nếu không có lệnh sumi nào đang chạy"
    local nb; nb="$(find "$CFG_DIR/backups" -mindepth 1 -maxdepth 2 2>/dev/null | wc -l)"
    ok_ "sao lưu: $nb mục trong $CFG_DIR/backups"
    echo "---"
    echo "$fails lỗi, $warns cảnh báo"
    [ "$fails" -eq 0 ]
}

lib_ok() {  # lib_ok <version> <range>: thoả requires_lib không
    local v="$1" range="$2" c op n vn rn
    vn="$(vnum "$v")"
    for c in $range; do
        op="${c%%[0-9]*}"; n="${c#"$op"}"; rn="$(vnum "$n")"
        [ -n "$op" ] || op="="
        case "$op" in
            ">=") [ "$vn" -ge "$rn" ] ;;  ">") [ "$vn" -gt "$rn" ] ;;
            "<=") [ "$vn" -le "$rn" ] ;;  "<") [ "$vn" -lt "$rn" ] ;;
            "=") [ "$vn" -eq "$rn" ] ;;   *) return 1 ;;
        esac || return 1
    done
    return 0
}
vnum() { local IFS=.; set -- $1; echo $(( 10#${1:-0} * 1000000 + 10#${2:-0} * 1000 + 10#${3:-0} )); }

cmd_app() {
    local app="$1"; shift
    [[ "$app" =~ ^[a-z][a-z0-9-]{1,31}$ ]] || die "tên app không hợp lệ: $app"
    local dir="$SUMI_HOME/apps/$app"
    [ -f "$dir/manifest.json" ] || die "app '$app' chưa cài ($dir/manifest.json không tồn tại)"
    need jq

    local kind; kind="$(manifest_field "$dir" '.kind')"
    local -a argv
    mapfile -t argv < <(run_argv "$dir") || true
    [ "${#argv[@]}" -gt 0 ] || die "manifest của '$app' thiếu 'run'"

    case "$kind" in
        oneshot)
            exec "${argv[@]}"
            ;;
        daemon)
            local fn="${1:-}"
            [ -n "$fn" ] || die "app '$app' cần tên function: sumi $app <function>"
            local target ipc
            target="$(manifest_field "$dir" '.ipc_target')"
            ipc="$(jq -r --arg f "$fn" '.functions[] | select(.id == $f or .ipc_name == $f) | (.ipc_name // .id)' "$dir/manifest.json" | head -n1)"
            [ -n "$ipc" ] || die "function '$fn' không có trong manifest của '$app'"
            if ! pgrep -f -- "-p $dir/shell.qml" >/dev/null 2>&1; then
                setsid "${argv[@]}" >"/tmp/sumi-$app.log" 2>&1 &
                disown
            fi
            # Poll mau (0.03s/lần, tối đa ~5s) để bắt socket IPC ngay khi sẵn sàng.
            local _
            for _ in $(seq 1 166); do
                if "${argv[@]}" ipc call "$target" "$ipc" 2>/dev/null; then exit 0; fi
                sleep 0.03
            done
            echo "sumi: không kết nối được tới '$app' sau khi khởi động. Xem /tmp/sumi-$app.log" >&2
            exit 1
            ;;
        *)
            die "manifest của '$app' có kind không hợp lệ: '$kind'"
            ;;
    esac
}

case "${1:-}" in
    "")       die "dùng: sumi <app> [function] | sumi hub | sumi list [--json] | sumi reset [--force] | sumi config apply|backups|restore | sumi store ... | sumi version | sumi update | sumi uninstall | sumi doctor" ;;
    hub)      cmd_hub ;;
    list)     shift; cmd_list "$@" ;;
    reset)    shift; cmd_reset "$@" ;;
    config)   shift; cmd_config "$@" ;;
    store)    shift; cmd_store "$@" ;;
    version|update|uninstall) cmd_self "$@" ;;
    doctor)   cmd_doctor ;;
    -h|--help) echo "dùng: sumi <app> [function] | sumi hub | sumi list [--json] | sumi reset [--force] | sumi config apply|backups|restore | sumi store ... | sumi version | sumi update | sumi uninstall | sumi doctor" ;;
    *)        cmd_app "$@" ;;
esac
